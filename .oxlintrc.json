{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "error",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "plugins": ["import", "jsx-a11y", "nextjs", "react", "typescript", "unicorn"],
  "jsPlugins": ["oxlint-tailwindcss", "@shadcn/lint"],
  "env": {
    "browser": true,
    "node": true,
    "es2026": true
  },
  "options": {
    "typeAware": true,
    "reportUnusedDisableDirectives": "warn"
  },
  "settings": {
    "next": {
      "rootDir": "."
    },
    "react": {
      "version": "19.3.0"
    },
    "tailwindcss": {
      "entryPoint": "src/app/globals.css"
    }
  },
  "rules": {
    "unicorn/filename-case": "error",
    "react/self-closing-comp": "error",
    "react/react-in-jsx-scope": "off",
    "react-hooks/exhaustive-deps": "error",
    "jsx-a11y/prefer-tag-over-role": "off",
    "import/no-cycle": "error",
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css"]
      }
    ],
    "typescript/no-explicit-any": "error",
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/prefer-nullish-coalescing": "error",
    "typescript/prefer-optional-chain": "error",
    "tailwindcss/no-conflicting-classes": "error",
    "tailwindcss/no-deprecated-classes": "error",
    "tailwindcss/no-duplicate-classes": "error",
    "tailwindcss/no-unknown-classes": "error",
    "tailwindcss/no-unnecessary-whitespace": "error",
    "tailwindcss/no-dark-without-light": "error",
    "tailwindcss/no-contradicting-variants": "error",
    "tailwindcss/enforce-canonical": "error",
    "tailwindcss/enforce-sort-order": "error",
    "tailwindcss/enforce-shorthand": "error",
    "tailwindcss/enforce-logical": "error",
    "tailwindcss/enforce-physical": "off",
    "tailwindcss/enforce-consistent-important-position": "error",
    "tailwindcss/enforce-negative-arbitrary-values": "error",
    "tailwindcss/enforce-consistent-variable-syntax": "error",
    "tailwindcss/consistent-variant-order": "error",
    "tailwindcss/no-restricted-classes": [
      "error",
      {
        "patterns": [
          {
            "pattern": "^(?:[a-z0-9-]+:)*space-[xy]-",
            "message": "Use flex or grid with gap-* instead."
          }
        ]
      }
    ],
    "tailwindcss/no-arbitrary-value": "error",
    "tailwindcss/no-hardcoded-colors": "error",
    "tailwindcss/no-unnecessary-arbitrary-value": "error",
    "tailwindcss/prefer-theme-tokens": "error",
    "typescript/prefer-readonly-parameter-types": "off"
  },
  "overrides": [
    {
      "files": ["**/*.test.{ts,tsx}"],
      "rules": {
        "typescript/no-unsafe-type-assertion": "off"
      }
    },
    {
      "files": ["src/components/ui/**"],
      "rules": {
        "tailwindcss/no-arbitrary-value": "off",
        "tailwindcss/enforce-logical": "off",
        "tailwindcss/consistent-variant-order": "off",
        "tailwindcss/enforce-sort-order": "off",
        "tailwindcss/no-conflicting-classes": "off"
      }
    }
  ],
  "ignorePatterns": [".next/**", "next-env.d.ts"]
}
