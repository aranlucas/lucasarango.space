{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": [
    "./node_modules/@aranlucas/oxforge/configs/recommended.json",
    "./node_modules/@aranlucas/oxforge/configs/nextjs.json",
    "./node_modules/@aranlucas/oxforge/configs/vitest.json",
    "./node_modules/@aranlucas/oxforge/configs/tailwind.json",
    "./node_modules/@aranlucas/oxforge/configs/type-aware.json"
  ],
  "jsPlugins": ["@shadcn/lint"],
  "env": {
    "node": true
  },
  "settings": {
    "next": {
      "rootDir": "."
    },
    "react": {
      "version": "19.3.0"
    },
    "tailwindcss": {
      "entryPoint": "src/app/globals.css"
    }
  },
  "rules": {
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css"]
      }
    ],
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/prefer-readonly-parameter-types": "off",
    "eslint/max-lines": "off",
    "eslint/max-lines-per-function": "off",
    "import/max-dependencies": "error",
    "eslint/no-inline-comments": "off",
    "eslint/no-negated-condition": "off",
    "eslint/require-unicode-regexp": "error",
    "eslint/sort-vars": "error",
    "jsx-a11y/control-has-associated-label": "error",
    "jsx-a11y/heading-has-content": "error",
    "jsx-a11y/no-noninteractive-element-interactions": "error",
    "react/exhaustive-effect-dependencies": "error",
    "react/jsx-no-target-blank": "error",
    "react/no-unsafe": "error",
    "typescript/no-confusing-void-expression": "error",
    "typescript/no-deprecated": "error",
    "typescript/no-unnecessary-boolean-literal-compare": "error",
    "typescript/no-unnecessary-type-parameters": "error",
    "typescript/strict-boolean-expressions": "error",
    "typescript/strict-void-return": "error",
    "unicorn/explicit-length-check": "error",
    "unicorn/no-array-callback-reference": "error",
    "unicorn/no-negated-condition": "error",
    "unicorn/prefer-number-coercion": "error",
    "unicorn/prefer-top-level-await": "error",
    "eslint/curly": "off",
    "oxforge/no-inline-types": "off",
    "react/only-export-components": "off",
    "promise/always-return": "off",
    "typescript/no-floating-promises": [
      "error",
      {
        "checkThenables": true,
        "ignoreVoid": true
      }
    ],
    "typescript/no-namespace": [
      "error",
      {
        "allowDeclarations": true
      }
    ],
    "typescript/restrict-template-expressions": "error",
    "eslint/no-console": "off",
    "eslint/no-magic-numbers": "off",
    "eslint/id-length": "off",
    "eslint/max-statements": "off",
    "eslint/func-style": "off",
    "eslint/new-cap": "off",
    "eslint/no-restricted-imports": "off",
    "unicorn/no-useless-undefined": "off",
    "unicorn/prefer-add-event-listener": "off",
    "unicorn/prefer-code-point": "off",
    "unicorn/no-this-assignment": "off",
    "unicorn/consistent-function-scoping": "off",
    "react/button-has-type": "off",
    "typescript/no-non-null-assertion": "off",
    "eslint/radix": "off",
    "anti-slop/no-array-filter-map": "off",
    "anti-slop/no-chained-type-assertions": "off",
    "anti-slop/no-conditional-empty-object-spread": "off",
    "anti-slop/no-known-value-widening": "off",
    "anti-slop/no-module-mocking": "off",
    "anti-slop/no-object-parameters": "off",
    "anti-slop/no-reduce-accumulator-copy": "off",
    "anti-slop/no-reflect-apply": "off",
    "anti-slop/no-reflect-get": "off",
    "anti-slop/no-runtime-typeof": "off",
    "anti-slop/no-shape-in-symbol-names": "off",
    "anti-slop/no-unknown-parameters": "off",
    "anti-slop/no-unknown-returns": "off",
    "anti-slop/no-unknown-type-aliases": "off",
    "anti-slop/no-unsafe-dictionary-type": "off",
    "anti-slop/no-widen-then-assert": "off",
    "anti-slop/require-readable-spacing": "off",
    "anti-slop/require-safety-comment-for-type-assertion": "off"
  },
  "overrides": [
    {
      "files": [
        "src/components/chat/icons.tsx",
        "src/components/forest-link.tsx",
        "src/components/receipt-art.tsx"
      ],
      "rules": {
        "anti-slop/no-shape-in-symbol-names": "off"
      }
    },
    {
      "files": ["**/*.test.{ts,tsx}"],
      "rules": {
        "typescript/no-unsafe-type-assertion": "off"
      }
    },
    {
      "files": ["src/components/ui/**"],
      "rules": {
        "tailwindcss/no-arbitrary-value": "off",
        "tailwindcss/enforce-logical": "off",
        "tailwindcss/consistent-variant-order": "off",
        "tailwindcss/enforce-sort-order": "off",
        "tailwindcss/no-conflicting-classes": "off",
        "jsx-a11y/click-events-have-key-events": "off",
        "jsx-a11y/no-noninteractive-element-interactions": "off",
        "typescript/no-unsafe-type-assertion": "off"
      }
    },
    {
      "files": ["src/app/(chat)/api/chat/handler.ts"],
      "rules": {
        "eslint/no-console": [
          "error",
          {
            "allow": ["error"]
          }
        ]
      }
    },
    {
      "files": ["postcss.config.mjs"],
      "rules": {
        "import/no-anonymous-default-export": "off"
      }
    }
  ],
  "ignorePatterns": [
    ".next/**",
    "next-env.d.ts",
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**"
  ]
}
