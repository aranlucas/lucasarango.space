{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "trailingComma": "all",
  "sortTailwindcss": {
    "functions": ["cn", "cva"],
    "stylesheet": "./src/app/globals.css"
  },
  "ignorePatterns": [
    "pnpm-lock.yaml",
    "src/components/ui/**",
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "tools/oxlint/anti-slop/**"
  ]
}
