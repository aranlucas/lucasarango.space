{
  "name": "lucasarango.space",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "portless run next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project node --project browser",
    "test:chrome": "pnpm test:e2e",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --fix-suggestions .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm fmt:check && pnpm test",
    "prepare": "husky",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.68",
    "@ai-sdk/react": "4.0.141",
    "@base-ui/react": "^1.9.0",
    "@react-three/fiber": "^9.8.1",
    "@shadcn/react": "^0.3.1",
    "@t3-oss/env-nextjs": "0.13.11",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "7.0.138",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.55.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shadcn": "^4.21.4",
    "shiki": "^4.5.0",
    "streamdown": "^2.7.0",
    "three": "^0.186.1",
    "unified": "^11.0.5",
    "use-webmcp-tool": "^0.3.0",
    "vfile": "^6.0.3",
    "vfile-matter": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aranlucas/oxforge": "^0.2.2",
    "@playwright/test": "^1.64.0",
    "@shadcn/helpers": "0.2.0",
    "@shadcn/lint": "^0.2.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tailwindcss": "^1.16.0",
    "oxlint-tsgolint": "^7.0.2004",
    "portless": "0.15.7",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --deny-warnings --fix"
    ],
    "*.{json,css,md,yml}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "packageManager": "pnpm@12.11.2"
}
