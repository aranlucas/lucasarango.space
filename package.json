{
  "name": "lucasarango.space",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "portless run next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.anti-slop.json",
    "test": "vitest run",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --fix-suggestions .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm fmt:check && pnpm test",
    "prepare": "husky",
    "test:e2e": "pnpm build && playwright test"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.137",
    "@base-ui/react": "^1.8.0",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@react-three/fiber": "^9.8.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "7.0.134",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.53.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shadcn": "^4.21.4",
    "shiki": "^4.5.0",
    "streamdown": "^2.7.0",
    "three": "^0.186.1",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "unified": "^11.0.5",
    "use-stick-to-bottom": "^1.1.6",
    "use-webmcp-tool": "^0.3.0",
    "vfile": "^6.0.3",
    "vfile-matter": "^5.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.87.0",
    "@playwright/test": "^1.64.0",
    "@shadcn/lint": "^0.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.1.2",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tailwindcss": "^1.14.0",
    "oxlint-tsgolint": "^7.0.2003",
    "portless": "0.15.7",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --deny-warnings --fix"
    ],
    "*.{json,css,md,yml}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "packageManager": "pnpm@12.10.1"
}
